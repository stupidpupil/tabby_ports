PortSystem          1.0

name                tabby_build_tools
version             2026-08-12
revision            0
categories          devel
supported_archs     noarch
license             permissive
maintainers         nomaintainer
description         Meta-port pinning common build-time tools as non-leaves
long_description     ${description}

homepage            https://github.com/stupidpupil/tabby_ports
distfiles

depends_run-append \
                    port:autoconf \
                    port:automake \
                    port:bsdmake \
                    port:bison \
                    port:cmake \
                    port:cctools \
                    port:flex \
                    port:libtool \
                    port:m4 \
                    port:meson \
                    port:nasm \
                    port:ninja \
                    port:gawk \
                    port:gettext \
                    port:git \
                    port:libgit2 \
                    port:pkgconfig \
                    port:texinfo \
                    port:yasm \
                    port:tabby_build_langs \
                    port:tabby_compilers

use_configure       no
build {}
destroot {
    xinstall -d ${destroot}${prefix}/share/doc/${name}
    xinstall -m 644 -W ${filespath} portfile.trace \
        ${destroot}${prefix}/share/doc/${name} 2>/dev/null
}
